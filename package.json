{
  "name": "@dsh-external/dsh-session-manager",
  "description": "会话管理插件：设置页查看全部会话（按创建日期/最近更新排序、手动删除）；启动时自动清理超期废弃会话",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.8"
  },
  "files": [
    "lib",
    "config.json",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErrorLst/dsh-session-manager.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
